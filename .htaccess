# Clean URL Rewriting
# Keeps public page files organized in /pages while preserving clean URLs.

RewriteEngine On

# Force HTTPS (uncomment in production)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Handle news detail routing
RewriteRule ^news/([0-9]+)/?$ pages/news.php?id=$1 [L,QSA]

# Handle authors-info sub-pages
RewriteRule ^authors-info/submission/?$ pages/authors-info-submission.php [L,QSA]
RewriteRule ^authors-info/([A-Za-z0-9_-]+)/?$ pages/$1.php [L,QSA]

# Handle committee sub-pages
RewriteRule ^committee/([A-Za-z0-9_-]+)/?$ pages/committee.php?page=$1 [L,QSA]

# Handle individual session pages
RewriteRule ^sessions/([A-Za-z0-9_-]+)/?$ pages/session-$1.php [L,QSA]

# Route clean top-level page URLs to organized page files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([A-Za-z0-9_-]+)/?$ pages/$1.php [L,QSA]

# Prevent directory listing
Options -Indexes

# Set default charset
AddDefaultCharset UTF-8

# Enable compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Browser caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
